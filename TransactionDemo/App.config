<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<system.serviceModel>

		<bindings>
			<wsHttpBinding>
				<binding name="WSHttpBinding_IService1" transactionFlow="true">
					<security mode="None" />
				</binding>
			</wsHttpBinding>
		</bindings>

		<client>
			<endpoint
				address="http://localhost:8733/BankService/Service1/"
				binding="wsHttpBinding"
				bindingConfiguration="WSHttpBinding_IService1"
				contract="BankServiceRef.IService1"
				name="WSHttpBinding_IService1" />
		</client>

	</system.serviceModel>

</configuration>